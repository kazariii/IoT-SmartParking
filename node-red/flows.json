  {
    "id": "sp_fn_mode_set",
    "type": "function",
    "z": "sp_tab",
    "name": "switchToModeSet",
    "func": "// Node-RED function node: switchToModeSet\n// Input : msg.payload dari ui-switch saat diklik (true = MANUAL, false = AUTO).\n// Output: perintah ke topik smartparking/<idkelompok>/mode/set.\n// Posisi switch baru berubah setelah ESP32 membalas lewat topik mode.\n\nmsg.payload = msg.payload === true ? \"MANUAL\" : \"AUTO\";\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 700,
    "y": 160,
    "wires": [
