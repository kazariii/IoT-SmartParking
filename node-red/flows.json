  {
    "id": "sp_fn_slot",
    "type": "function",
    "z": "sp_tab",
    "name": "formatSlot",
    "func": "// Node-RED function node: formatSlot\n// Input : msg.payload dari topik smartparking/<idkelompok>/slot (\"KOSONG\" / \"TERISI\")\n// Output: teks + warna untuk widget ui-text (Dashboard 2.0)\n\nconst status = String(msg.payload).trim().toUpperCase();\n\nif (status === \"KOSONG\") {\n    msg.payload = \"KOSONG\";\n    msg.ui_update = { color: \"#1a7f37\" };\n} else if (status === \"TERISI\") {\n    msg.payload = \"TERISI\";\n    msg.ui_update = { color: \"#cf222e\" };\n} else {\n    node.warn(\"Payload slot tidak dikenal: \" + msg.payload);\n    return null;\n}\n\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 300,
    "y": 80,
    "wires": [
      [
        "sp_ui_slot"
      ]
    ]
  },
