  {
    "id": "sp_fn_mode_switch",
    "type": "function",
    "z": "sp_tab",
    "name": "modeToSwitch",
    "func": "// Node-RED function node: modeToSwitch\n// Input : msg.payload dari topik smartparking/<idkelompok>/mode (\"AUTO\" / \"MANUAL\"),\n//         yaitu mode asli yang dilaporkan ESP32.\n// Output: true (MANUAL) / false (AUTO) untuk widget ui-switch.\n// Switch diset \"decouple\", jadi pesan ini hanya mengubah tampilan dan tidak\n// dikirim balik ke ESP32 (tidak ada loop echo).\n\nconst mode = String(msg.payload).trim().toUpperCase();\n\nif (mode !== \"AUTO\" && mode !== \"MANUAL\") {\n    node.warn(\"Payload mode tidak dikenal: \" + msg.payload);\n    return null;\n}\n\nmsg.payload = mode === \"MANUAL\";\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 300,
    "y": 160,
    "wires": [
      [
        "sp_ui_mode"
      ]
    ]
  },
